    {
      "name": "Todos",
      "description": "Full CRUD for TODOs. All requests in this folder are protected — they inherit the Bearer `{{access_token}}` set at the collection level.\n\nRun **Login** or **Register** first. The `todo_id` variable is automatically captured when you create a TODO.",
      "item": [
        {
          "name": "Get All Todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns todo list', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json).to.have.property('count');",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.count).to.equal(json.data.length);",
                  "});",
                  "",
                  "// If todos already exist, save the first ID for quick use",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0 && !pm.environment.get('todo_id')) {",
                  "  pm.environment.set('todo_id', json.data[0]._id);",
                  "  console.log('todo_id set from first result:', json.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/todos",
              "host": ["{{base_url}}"],
              "path": ["api", "todos"]
            },
            "description": "Fetch all TODOs belonging to the currently authenticated user, sorted newest first.\n\nOther users' TODOs are never returned."
