              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Issues a new access token (15 min) using the refresh token stored in the HTTP-only cookie.\n\nThe refresh token is also rotated — a new one is issued and the old one is invalidated.\n\nNo request body is needed. The cookie is sent automatically by Postman if you logged in during this session."
          },
          "response": [
            {
              "name": "200 — New Access Token",
              "originalRequest": {
