                "url": { "raw": "{{base_url}}/api/auth/refresh" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"accessToken\": \"<new_jwt_access_token>\"\n}"
            }
          ]
